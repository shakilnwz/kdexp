# Prevent Ctrl+\ from sending SIGQUIT in interactive shells
if [[ -t 0 ]]; then
    stty quit undef 2>/dev/null || true
fi

# Ensure ~/.local/bin is at the beginning of PATH
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

# Source shared aliases
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.kdexp}"
if [[ -f "$DOTFILES_DIR/rc/aliases.sh" ]]; then
    source "$DOTFILES_DIR/rc/aliases.sh"
elif [[ -f "$HOME/.config/kdexp/rc/aliases.sh" ]]; then
    source "$HOME/.config/kdexp/rc/aliases.sh"
fi

# Bind Ctrl+\ to herdr-sessionizer in Bash
if command -v herdr-sessionizer >/dev/null 2>&1; then
    bind -x '"\C-\\":"herdr-sessionizer"' 2>/dev/null || true
fi

# Initialize Starship Prompt
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
fi

# Source FZF bash completion if installed
if [[ -f /usr/share/doc/fzf/examples/key-bindings.bash ]]; then
    source /usr/share/doc/fzf/examples/key-bindings.bash 2>/dev/null || true
elif [[ -f "$HOME/.fzf.bash" ]]; then
    source "$HOME/.fzf.bash" 2>/dev/null || true
fi
# <<< kdexp dotfiles <<<
