#!/usr/bin/env bash
set -euo pipefail

switch_to() {
    if [[ -z "${TMUX:-}" ]]; then
        tmux attach-session -t "$1"
    else
        tmux switch-client -t "$1"
    fi
}

has_session() {
    tmux list-sessions -F '#S' 2>/dev/null | grep -Fxq -- "$1"
}

hydrate() {
    if [ -f "$2/.tmux-sessionizer" ]; then
        tmux send-keys -t "$1" "source $2/.tmux-sessionizer" c-M
    elif [ -f "$HOME/.tmux-sessionizer" ]; then
        tmux send-keys -t "$1" "source $HOME/.tmux-sessionizer" c-M
    fi
}

BAT_CMD=$(command -v bat 2>/dev/null || command -v batcat 2>/dev/null || echo "cat")

if [[ $# -ge 1 && -n "${1:-}" ]]; then
    selected="$1"
else
    search_dirs=()
    for d in "$HOME/.kdexp" "$HOME/.dotfiles" "$HOME/code" "$HOME/Backup" "$HOME/Documents" "$HOME/Downloads" "$HOME/.local/bin" "$HOME/.config"; do
        [[ -d "$d" ]] && search_dirs+=("$d")
    done
    [[ ${#search_dirs[@]} -eq 0 ]] && search_dirs=("$HOME")

    selected=$(
        find "${search_dirs[@]}" -mindepth 0 -maxdepth 5 \( -name .git -o -name node_modules -o -name .venv -o -name target \) -prune -o -type d -print 2>/dev/null |
            sed "s|$HOME|~|" |
            fzf --preview "[ -f {}/README.md ] && $BAT_CMD --color=always {}/README.md || [ -f {}/readme.md ] && $BAT_CMD --color=always {}/readme.md || [ -f {}/index.html ] && $BAT_CMD --color=always {}/index.html || echo 'No README.md or index.html found in {}'" --preview-window right:50%:wrap
    )
    selected="${selected/#\~/$HOME}"
fi

if [[ -z "${selected:-}" ]]; then
    exit 0
fi

selected=$(realpath -- "$selected")
selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux || true)

if [[ -z "${TMUX:-}" ]] && [[ -z "$tmux_running" ]]; then
    tmux new-session -s "$selected_name" -c "$selected"
    hydrate "$selected_name" "$selected"
    exit 0
fi

if ! has_session "$selected_name"; then
    tmux new-session -ds "$selected_name" -c "$selected"
    hydrate "$selected_name" "$selected"
fi

switch_to "$selected_name"
