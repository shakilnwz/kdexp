#!/usr/bin/env bash
# Cycle display configurations (X11 / KDE / Hyprland compatible)
set -euo pipefail

notify() {
    local summary="$1"
    local body="${2:-}"
    local urgency="${3:-normal}"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u "$urgency" -t 3000 "$summary" "$body"
    else
        echo "[$summary] $body"
    fi
}

# If on X11 and xrandr is available
if [[ -n "${DISPLAY:-}" ]] && command -v xrandr >/dev/null 2>&1; then
    connected_monitors=($(xrandr --query | grep " connected" | cut -d" " -f1))
    
    if [[ ${#connected_monitors[@]} -le 1 ]]; then
        notify "Display Setup" "Single monitor setup detected (${connected_monitors[0]:-default})." "normal"
        exit 0
    fi

    # If KDE OSD display switch is available
    if command -v qdbus >/dev/null 2>&1; then
        qdbus org.kde.KScreen /org/kde/KScreen org.kde.KScreen.displayOSD 2>/dev/null || true
    fi
    exit 0
fi

# Hyprland fallback
if command -v hyprctl >/dev/null 2>&1; then
    notify "Display Setup" "Hyprland environment detected." "normal"
fi
