#!/usr/bin/env bash
# User-space Caps Lock remap: Tap = Escape, Hold = Control
# Safe for multi-user machines: runs purely within the current user's session.
set -euo pipefail

export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

apply_remap() {
    if [[ -n "${DISPLAY:-}" ]] && command -v setxkbmap >/dev/null 2>&1; then
        # Reset and set Caps Lock as Control
        setxkbmap -option -option caps:ctrl_modifier 2>/dev/null || setxkbmap -option caps:ctrl_modifier 2>/dev/null || true

        if command -v xcape >/dev/null 2>&1; then
            pkill -x xcape 2>/dev/null || true
            xcape -e 'Control_L=Escape'
            if [[ -t 1 ]]; then
                echo "✓ Caps Lock remapped: Tap = Escape, Hold = Control (xcape active)"
            fi
            return 0
        fi
    fi
    return 1
}

ensure_xbindkeys() {
    if [[ -n "${DISPLAY:-}" ]] && command -v xbindkeys >/dev/null 2>&1; then
        local config_file="$HOME/.config/xbindkeys/config"
        if [[ -f "$config_file" ]] && ! pgrep -x xbindkeys >/dev/null 2>&1; then
            xbindkeys -f "$config_file" 2>/dev/null || true
        fi
    fi
}

apply_remap || true
ensure_xbindkeys || true

# In background/autostart mode, re-apply after desktop keyboard daemon finishes initialization
if [[ ! -t 1 ]]; then
    (
        for delay in 2 5 10; do
            sleep "$delay"
            if [[ -n "${DISPLAY:-}" ]] && command -v setxkbmap >/dev/null 2>&1; then
                setxkbmap -option -option caps:ctrl_modifier 2>/dev/null || setxkbmap -option caps:ctrl_modifier 2>/dev/null || true
                if command -v xcape >/dev/null 2>&1 && ! pgrep -x xcape >/dev/null 2>&1; then
                    xcape -e 'Control_L=Escape' 2>/dev/null || true
                fi
            fi
            ensure_xbindkeys || true
        done
    ) >/dev/null 2>&1 & disown
fi

if [[ -t 1 ]]; then
    if command -v xcape >/dev/null 2>&1; then
        echo "✓ Caps Lock remapped: Control active"
    else
        echo "ℹ Caps Lock mapped to Control. (Install 'xcape' for Tap = Escape dual functionality: sudo apt install xcape)"
    fi
fi
