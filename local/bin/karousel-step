#!/usr/bin/env bash
# ==============================================================================
# karousel-step: Step carousel focus left or right via D-Bus shortcut invocation
# Used for mouse wheel navigation (Meta + Scroll Up / Down) and CLI control
# ==============================================================================
set -euo pipefail

dir="${1:-right}"
shortcut="karousel-focus-right"
fallback="focus-right"
if [[ "$dir" == "left" || "$dir" == "prev" || "$dir" == "up" ]]; then
    shortcut="karousel-focus-left"
    fallback="focus-left"
fi

invoke() {
    local comp="$1"
    local sc="$2"
    if command -v qdbus6 >/dev/null 2>&1; then
        qdbus6 org.kde.kglobalaccel "/component/$comp" invokeShortcut "$sc"
    elif command -v qdbus >/dev/null 2>&1; then
        qdbus org.kde.kglobalaccel "/component/$comp" invokeShortcut "$sc"
    elif command -v dbus-send >/dev/null 2>&1; then
        dbus-send --session --type=method_call --dest=org.kde.kglobalaccel "/component/$comp" org.kde.kglobalaccel.Component.invokeShortcut string:"$sc"
    else
        return 1
    fi
}

invoke kwin "$shortcut" 2>/dev/null || \
invoke karousel "$shortcut" 2>/dev/null || \
invoke kwin "$fallback" 2>/dev/null || \
invoke karousel "$fallback" 2>/dev/null || true
