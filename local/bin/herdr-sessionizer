#!/usr/bin/env bash
set -euo pipefail

# 1. Parse flags
DUAL_MODE=false
if [[ "${1:-}" == "--dual" ]]; then
    DUAL_MODE=true
    shift
fi

# 2. Determine selected directory
if [[ $# -ge 1 && -n "${1:-}" ]]; then
    selected="$1"
else
    # Build list of existing search candidate directories
    search_dirs=()
    for d in "$HOME/.kdexp" "$HOME/.dotfiles" "$HOME/code" "$HOME/Backup" "$HOME/Documents" "$HOME/Downloads" "$HOME/.local/bin" "$HOME/.config"; do
        [[ -d "$d" ]] && search_dirs+=("$d")
    done
    [[ ${#search_dirs[@]} -eq 0 ]] && search_dirs=("$HOME")

    selected=$(
        find "${search_dirs[@]}" -mindepth 0 -maxdepth 5 \( -name .git -o -name node_modules -o -name .venv -o -name target \) -prune -o -print 2>/dev/null |
            sed "s|$HOME|~|" |
            fzf --preview '[ -f {} ] && head -n 200 {} 2>/dev/null || [ -f {}/README.md ] && cat {}/README.md || [ -f {}/readme.md ] && cat {}/readme.md || [ -f {}/index.html ] && cat {}/index.html || echo "Path: {}"' --preview-window right:50%:wrap
    )
    selected="${selected/#\~/$HOME}"
fi

[[ -z "${selected:-}" ]] && exit 0
[[ -f "$selected" ]] && selected=$(dirname -- "$selected")
[[ ! -d "$selected" ]] && { echo "Directory not found: $selected" >&2; exit 1; }

selected=$(realpath -- "$selected")
selected_name=$(basename "$selected" | tr . _)

# 3. Helper to ensure a server is running
ensure_server() {
    local session_arg="$1"
    if ! herdr $session_arg workspace list >/dev/null 2>&1; then
        (cd "$selected" && herdr $session_arg server >/dev/null 2>&1 &)
        for _ in {1..30}; do
            if herdr $session_arg workspace list >/dev/null 2>&1; then return 0; fi
            sleep 0.1
        done
    fi
}

# 4. Helper to ensure a workspace exists and is focused
ensure_workspace() {
    local session_arg="$1"
    local ws_json
    ws_json=$(herdr $session_arg workspace list 2>/dev/null || echo "")
    
    local matching_ws_id
    matching_ws_id=$(echo "$ws_json" | python3 -c '
import sys, json
try:
    for ws in json.load(sys.stdin).get("result", {}).get("workspaces", []):
        if ws.get("label") == sys.argv[1]:
            print(ws.get("workspace_id"))
            break
except Exception: pass
' "$selected_name")

    if [[ -n "$matching_ws_id" ]]; then
        herdr $session_arg workspace focus "$matching_ws_id" >/dev/null
    else
        herdr $session_arg workspace create --label "$selected_name" --cwd "$selected" --focus >/dev/null 2>&1
    fi
}

# 5. Setup Default Session (Agent)
ensure_server ""
ensure_workspace ""

# 6. Setup Editor Session (if --dual)
if $DUAL_MODE; then
    ensure_server "--session editor"
    ensure_workspace "--session editor"
    
    # Launch second window in Ghostty directly
    if command -v ghostty >/dev/null 2>&1; then
        ghostty -e herdr --session editor &
    else
        x-terminal-emulator -e herdr --session editor &
    fi
fi

# 7. Attach the current terminal to the Default Session
if [[ -z "${HERDR_ENV:-}" ]]; then
    cd "$selected" && exec herdr
fi
