#!/usr/bin/env bash
set -euo pipefail

LABEL="vnote"
WORKDIR="$HOME/Documents/shakilnwz_notes"

# Ensure notes directory exists
mkdir -p "$WORKDIR"

# If a file was passed as argument directly, use it
if [[ $# -ge 1 && -n "${1:-}" ]]; then
    if [[ -f "$WORKDIR/$1" ]]; then
        target_file="$WORKDIR/$1"
    elif [[ -f "$1" ]]; then
        target_file=$(realpath "$1")
    else
        # Treat argument as note name
        clean_name="${1%.md}.md"
        target_file="$WORKDIR/$clean_name"
        mkdir -p "$(dirname "$target_file")"
        [[ ! -f "$target_file" ]] && touch "$target_file"
    fi
else
    # Launch interactive fzf search on .md files in $WORKDIR with side bat preview
    cd "$WORKDIR"
    fzf_output=$(
        find . -type f -name "*.md" 2>/dev/null |
            sed 's|^\./||' |
            sort |
            fzf \
                --print-query \
                --layout=reverse \
                --border=rounded \
                --preview="bat --style=plain --color=always '$WORKDIR/{}' 2>/dev/null || cat '$WORKDIR/{}'" \
                --preview-window="right:60%:wrap" \
                --prompt="📓 Note > " \
                --header="[Enter] Open existing / Create new | [Esc] Exit" || true
    )

    # If user cancelled fzf (empty output)
    if [[ -z "${fzf_output:-}" ]]; then
        exit 0
    fi

    query=$(echo "$fzf_output" | sed -n '1p')
    selected=$(echo "$fzf_output" | sed -n '2p')

    if [[ -n "$selected" && -f "$WORKDIR/$selected" ]]; then
        # 1. Existing note selected
        target_file="$WORKDIR/$selected"
    elif [[ -n "$query" ]]; then
        # 2. Query entered for a new note
        clean_name="${query%.md}.md"
        target_file="$WORKDIR/$clean_name"
        mkdir -p "$(dirname "$target_file")"
        if [[ ! -f "$target_file" ]]; then
            touch "$target_file"
        fi
    else
        # 3. Fallback: open notes directory in neovim
        target_file=""
    fi
fi

# 1. Check if Herdr socket is reachable
is_herdr_running() {
    herdr workspace list >/dev/null 2>&1
}

ensure_herdr_running() {
    if ! is_herdr_running; then
        (cd "$WORKDIR" && herdr server >/dev/null 2>&1 &)
        for _ in {1..30}; do
            if is_herdr_running; then
                return 0
            fi
            sleep 0.1
        done
        return 1
    fi
}

ensure_herdr_running || true

if is_herdr_running; then
    ws_json=$(herdr workspace list 2>/dev/null || echo "")
    
    # Check if a workspace with label == "vnote" exists
    matching_ws_id=$(echo "$ws_json" | python3 -c '
import sys, json
try:
    data = json.load(sys.stdin)
    workspaces = data.get("result", {}).get("workspaces", [])
    target_names = ["vnote", "📝 vnote", "notes"]
    for ws in workspaces:
        if ws.get("label") in target_names:
            print(ws.get("workspace_id"))
            break
except Exception:
    pass
')

    if [[ -n "$matching_ws_id" ]]; then
        # Workspace already exists -> switch focus to it
        herdr workspace focus "$matching_ws_id" >/dev/null
        
        # If a specific note was selected, tell Neovim in that workspace to open it
        if [[ -n "${target_file:-}" ]]; then
            pane_json=$(herdr pane list --workspace "$matching_ws_id" 2>/dev/null || echo "")
            target_pane=$(echo "$pane_json" | python3 -c '
import sys, json
try:
    data = json.load(sys.stdin)
    panes = data.get("result", {}).get("panes", [])
    if panes:
        print(panes[0].get("pane_id", ""))
except Exception:
    pass
')
            if [[ -n "$target_pane" ]]; then
                herdr pane send-keys "$target_pane" "esc" >/dev/null 2>&1 || true
                herdr pane run "$target_pane" ":e '$target_file'" >/dev/null 2>&1 || true
            fi
        fi
    else
        # Workspace does not exist -> create workspace with cwd $WORKDIR and open Neovim
        create_res=$(herdr workspace create --label "$LABEL" --cwd "$WORKDIR" --focus 2>/dev/null)
        root_pane_id=$(echo "$create_res" | python3 -c '
import sys, json
try:
    data = json.load(sys.stdin)
    print(data.get("result", {}).get("root_pane", {}).get("pane_id", ""))
except Exception:
    pass
')

        if [[ -n "$root_pane_id" ]]; then
            if [[ -n "${target_file:-}" ]]; then
                herdr pane run "$root_pane_id" "nvim '$target_file'" >/dev/null 2>&1 || true
            else
                herdr pane run "$root_pane_id" "nvim ." >/dev/null 2>&1 || true
            fi
        fi
    fi
fi

# If outside Herdr (opened directly via keybinding/terminal), launch/attach Herdr UI
if [[ -z "${HERDR_ENV:-}" ]]; then
    cd "$WORKDIR" && exec herdr
fi
