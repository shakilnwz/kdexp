#!/usr/bin/env bash
# ==============================================================================
# workspace-step: Step virtual desktop (workspace) left/right via D-Bus
# Used for mouse wheel navigation (Meta + Scroll Up / Down) and CLI control
# ==============================================================================
set -euo pipefail

dir="${1:-next}"
shortcut="Switch to Next Desktop"
dbus_method="nextDesktop"
if [[ "$dir" == "left" || "$dir" == "prev" || "$dir" == "up" ]]; then
    shortcut="Switch to Previous Desktop"
    dbus_method="previousDesktop"
fi

if command -v qdbus6 >/dev/null 2>&1; then
    qdbus6 org.kde.kglobalaccel /component/kwin invokeShortcut "$shortcut" 2>/dev/null || \
    qdbus6 org.kde.KWin /KWin "org.kde.KWin.$dbus_method" 2>/dev/null || true
elif command -v qdbus >/dev/null 2>&1; then
    qdbus org.kde.kglobalaccel /component/kwin invokeShortcut "$shortcut" 2>/dev/null || \
    qdbus org.kde.KWin /KWin "org.kde.KWin.$dbus_method" 2>/dev/null || true
elif command -v dbus-send >/dev/null 2>&1; then
    dbus-send --session --type=method_call --dest=org.kde.kglobalaccel /component/kwin org.kde.kglobalaccel.Component.invokeShortcut string:"$shortcut" 2>/dev/null || true
fi
